# Что бы настроить и запустить проект локально выполните
# команду "cp .env.example .env" и подставтье значения 
# в переменные

# API-ключ нейросети для распознавания растения (например Pl@ntNet)
IDENTIFIER_API_KEY=
# API-ключ нейросетей для диалогов и генераций отчета
PROVIDER_API_KEY=
# API URL для распознавания растения
IDENTIFIER_API_URL="https://my-api.plantnet.org/v2/identify/all"
# API URL для диалогов и генераций отчета
PROVIDER_URL="https://openrouter.ai/api/v1"
# Модель для диалогов и генераций отчета
MODEL_NAME="baidu/ernie-5.5-flash-preview:free"
# Модель для распознавания растений во время диалога
MULTIMODAL_MODEL_NAME="inclusionai/ling-3.2-flash:free"

# Имя пользователя базы данных
POSTGRES_USER="botanix"
# Название базы данных
POSTGRES_DB="botanix-postgres"
# Пароль базы данных
POSTGRES_PASSWORD=
# Хост базы данных
POSTGRES_HOST="127.0.0.1"
# Порт базы данных
POSTGRES_POR=5433

# Токен Telegram бота
BOT_TOKEN=
# Внутренний токен для распознавания пользователя на бекенде
# Используйте "openssl rand -hex 32" для создания токена
BOT_INTERNAL_SECRET=

# Режим работы бекенд части. По умолчанию "False"
# DEBUG: bool = False

# Допустимые URL для запросов к API
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Идентификатор статического ключа доступа (Ключ сервисного аккаунта)
S3_ACCESS_KEY=
# Секретный ключ бакета S3
S3_SECRET_KEY=
# Имя бакета
S3_BUCKET_NAME="botanix-ai"
# Эндпоинт S3 сервиса
S3_ENDPOINT_URL="https://storage.yandexcloud.net"
# Публичный URL для раздачи картинок
S3_PUBLIC_BASE_URL=""
# Регион сервера сервиса
S3_REGION="ru-central1"

# Локальный URL бекенда
BACKEND_URL="http://localhost:8000"
# Локальный URL фронтенда
WEB_APP_URL="http://localhost:5173"